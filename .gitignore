# --- Secrets & local config ---
.env
*.local.yaml

# --- ONASSIS runtime artifacts ---
data/*.db
data/*.sqlite3
# OAuth token bundles + pending PKCE state — secrets, never commit.
data/*_tokens.json
data/*_tokens_pending.json
logs/*.log
logs/*.log.*
exports/

# --- Operations (Sprint 38) ---
# Timestamped backups (backup.sh) and the deploy rollback-point marker.
backups/
.onassis_deploy_state

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# --- Tooling / IDE ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.DS_Store
.idea/
.vscode/

# --- Sprint 40.1: Repository & Deployment Hygiene ---
# Runtime data lives OUTSIDE the repo (ONASSIS_RUNTIME_DIR); these patterns
# also catch the repo-local defaults so runtime state is never tracked.
data/
runtime/
uploads/
cache/
tmp/
*.tmp
*.pid
*.sock

# Git bundles (out-of-band code transfer, never source)
*.bundle

# Personal / operator notes (kept local, never committed)
NOTES.md
NOTES*.md
notes/
scratch/
TODO.local.md

# Server / deployment configuration (environment-specific, not source)
*.service
*.socket
nginx.conf
*.nginx
Caddyfile
gunicorn.conf.py
.env.*
!.env.example
# …but the versioned systemd templates under deploy/ ARE source.
!deploy/systemd/*.service
!deploy/systemd/*.socket

# Deployment state markers
.onassis_deploy_state
.onassis_restart_required
onassis.db
