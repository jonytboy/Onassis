# ONASSIS environment variables
# -------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. The `.env` file is
# git-ignored so secrets never get committed.
#
# Values defined here OVERRIDE matching keys in config.yaml at runtime.
# Anything left blank simply falls back to the config.yaml default.

# --- Core ---
ONASSIS_ENV=development            # development | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# --- Database ---
ONASSIS_DB_PATH=data/onassis.db    # SQLite file location (relative to repo root)

# --- Scheduler ---
ONASSIS_RUN_AT=08:00               # Daily run time, 24h HH:MM (local time)

# --- Brand identity (used by the Content Director when building briefs) ---
ONASSIS_BRAND_NAME=Onassis Lifestyle

# --- LLM provider (RESERVED for a future version) ---
# v0.1 ships a deterministic, template-based content generator so it runs
# with zero external dependencies. When you wire in a real model, read the
# key from here instead of hardcoding it.
ANTHROPIC_API_KEY=
